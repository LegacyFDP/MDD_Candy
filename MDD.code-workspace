{
  "folders": [
    {
      "name": "backend",
      "path": "backend"
    },
    {
      "name": "frontend",
      "path": "frontend"
    },
    {
      "name": "server",
      "path": "server"
    },
    {
      "name": "deploy",
      "path": "deploy"
    },
    {
      "name": "db",
      "path": "db"
    },
    {
      "name": "public",
      "path": "public"
    },
    {
      "name": "notes",
      "path": "notes"
    },
    // Optional legacy/parallel project
    {
      "name": "fete-store",
      "path": "fete-store"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // Python venv for backend
    "python.defaultInterpreterPath": "${workspaceFolder:backend}/.venv/Scripts/python.exe",
    // Node tooling
    "javascript.updateImportsOnFileMove.enabled": "always",
    "npm.packageManager": "npm",
    // Hide clutter
    "files.exclude": {
      "**/node_modules": true,
      "**/.history": true,
      "**/.history-files": true,
      "**/.vscode": false
    },
    // Git quality-of-life
    "git.enableSmartCommit": true,
    "git.confirmSync": false
  },
  "extensions": {
    "recommendations": [
      "ms-azuretools.vscode-docker",
      "ms-python.python",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.remote-repositories"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Backend: Node",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder:backend}/server.js",
        "cwd": "${workspaceFolder:backend}",
        "envFile": "${workspaceFolder:backend}/.env"
      },
      {
        "name": "Frontend: Vite Dev",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder:frontend}/node_modules/.bin/vite",
        "cwd": "${workspaceFolder:frontend}"
      },
      {
        "name": "Server: Node",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder:server}/server.js",
        "cwd": "${workspaceFolder:server}"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack",
        "configurations": [
          "Backend: Node",
          "Frontend: Vite Dev",
          "Server: Node"
        ]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Backend: Install",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder:backend}"
        }
      },
      {
        "label": "Frontend: Install",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder:frontend}"
        }
      },
      {
        "label": "Server: Install",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder:server}"
        }
      },
      {
        "label": "Deploy: Run",
        "type": "shell",
        "command": "./deploy.sh",
        "options": {
          "cwd": "${workspaceFolder:deploy}"
        }
      },
      {
        "label": "DB: Migrate",
        "type": "shell",
        "command": "python migrate.py",
        "options": {
          "cwd": "${workspaceFolder:db}"
        }
      }
    ]
  }
}