# Copy to .env and fill in. The server loads this automatically (dotenv).

# Port and bind address for the Node server.
# Behind the reverse proxy (Caddy), bind to localhost only.
PORT=8080
HOST=127.0.0.1

# SQLite database file. This path is resolved from the server working directory.
# Keep this pointing at the existing production data file unless a deliberate
# database migration has been planned and backed up.
DB_PATH=./fete_store.db
