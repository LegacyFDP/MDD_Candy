# Copy to .env and fill in. The server loads this automatically (dotenv).

# Port and bind address for the Node server.
# Behind the reverse proxy (Caddy), bind to localhost only.
PORT=8080
HOST=127.0.0.1

# Required: absolute or relative path to the live SQLite database file.
DB_PATH=../MDD_Candy.db

# Required: directory where backup files are created and managed.
DB_BACKUP_DIR=../backups
